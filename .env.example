# APIFoundry environment configuration.
# Copy this file to `.env` and adjust values as needed. `.env` is git-ignored; only this example
# file (with placeholder, non-secret values) is committed. All values are parsed and validated by
# src/config/env.schema.ts — an invalid value here causes the server to fail fast on startup with
# a descriptive error instead of running with a bad configuration.

# Port the HTTP server listens on. Integer, 1-65535. Default: 3000.
PORT=3000

# Runtime environment name. One of: development | test | production. Affects only
# environment-labeling (e.g. NODE_ENV=test is used by the automated test suite); it does not
# change error-handling strictness. Default: development.
NODE_ENV=development

# Path prefix under which every versioned resource/feature endpoint is mounted (e.g.
# /api/v1/users). Must start with "/". Meta endpoints (/health, /version, etc.) live outside this
# prefix. Default: /api/v1.
API_PREFIX=/api/v1

# Secret key used to sign and verify JSON Web Tokens (HS256) issued by POST /auth/login,
# POST /auth/token, and verified by every JWT-protected endpoint. Never reuse the placeholder
# value in a real deployment. Default: change-me.
JWT_SECRET=change-me

# Expected `iss` (issuer) claim on every JWT this server issues and verifies. A token whose issuer
# does not match this value is rejected as "wrong-issuer". Default: mock-api-server.
JWT_ISSUER=mock-api-server

# Expected `aud` (audience) claim on every JWT this server issues and verifies. A token whose
# audience does not match this value is rejected as "wrong-audience". Default: mock-api-client.
JWT_AUDIENCE=mock-api-client

# Access token lifetime, in seconds, from issuance to expiry. Refresh tokens live 24x longer (a
# fixed in-code multiplier, not separately configurable). Positive integer. Default: 3600 (1 hour).
JWT_EXPIRES_IN=3600

# Master switch for the rate-limiting middleware on GET /rate-limit. When false, that endpoint
# never returns 429 regardless of request volume. Boolean (true/false). Default: false.
RATE_LIMIT_ENABLED=false

# Maximum number of requests allowed per client within RATE_LIMIT_WINDOW_MS before GET /rate-limit
# starts responding 429 with a Retry-After header. Only enforced when RATE_LIMIT_ENABLED=true.
# Positive integer. Default: 100.
RATE_LIMIT_REQUESTS=100

# Length of the sliding/fixed rate-limit window, in milliseconds, that RATE_LIMIT_REQUESTS is
# measured against. Positive integer. Default: 60000 (1 minute).
RATE_LIMIT_WINDOW_MS=60000

# Upper bound, in milliseconds, that GET /delay/{ms} and GET /delay?ms= are allowed to request. A
# caller-supplied delay greater than this value is rejected rather than honored, so a single
# request can never stall the process for an unbounded time. Non-negative integer.
# Default: 10000 (10 seconds).
MAX_DELAY_MS=10000

# Upper bound on request/response body size across the server (Express's body-parser limit and the
# ceiling for GET /payload/{size}'s generated payloads). Accepts any size string understood by the
# `bytes` library (e.g. "10mb", "500kb"). Default: 10mb.
MAX_PAYLOAD_SIZE=10mb

# Default failure probability (0-1) for GET /flaky when its own `failureRate` query parameter is
# omitted. 0 means never fail; 1 means always fail. Number between 0 and 1 inclusive.
# Default: 0.
FAILURE_RATE=0

# Master switch for GET /flaky's failure simulation. When false, that endpoint always returns 200
# regardless of the `failureRate` query parameter. Boolean (true/false). Default: true.
FLAKY_ENABLED=true

# Bearer token required to call the admin-only endpoints (POST /admin/reset,
# POST /admin/auth/reset) that reset seed data, tokens, API keys, and rate-limit/idempotency
# state. Never reuse the placeholder value in a real deployment. Default: admin-secret.
ADMIN_TOKEN=admin-secret

# Value written to the Access-Control-Allow-Origin response header by the CORS middleware. Use
# "*" to allow any origin, or a specific origin (e.g. "https://example.com") to restrict it.
# Default: *.
CORS_ORIGIN=*
